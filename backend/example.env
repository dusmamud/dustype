PORT=5005
# MongoDB persistence (Phase 2). When unset, the backend uses
# in-memory stores and works with no database at all.
# DB_URI=mongodb://localhost:27017/dustype
# Secret for signing auth tokens (HMAC-SHA256). Set a long random
# value in production — never commit a real secret to this file.
# When unset, a dev-only fallback secret is used (see src/auth.ts).
# JWT_SECRET=change-me-to-a-long-random-secret

# Phase 3 rate limits (see src/middleware/rateLimit.ts).
# These are code constants, not env vars, and are documented here
# so operators can find them in one place:
# - POST /api/auth/register and POST /api/auth/login:
#   10 attempts per 15 minutes per key (user id if present, else IP).
#   Returns 429 with {"error": "Too many requests, please try again later."}
# - POST /api/results: 60 submissions per hour per key (user id if
#   present, else IP). Same 429 shape.
# Caveat: the limiter is in-memory only, so a restart resets all
# counters and counters are not shared across backend instances.
# A Redis-backed limiter is a later phase if that is ever needed.

# Phase 3 result validation (see src/validation/results.ts).
# Rejected with 400 and never stored, before any DB write:
# - No characters typed, non-positive elapsed, or elapsed > 3600s.
# - wordCount >= 10 and elapsed < 0.2s per word, or > 180s per word.
# - With 50+ total characters: accuracy < 20%, or WPM > 300.
# - WPM exceeding raw WPM by more than 5 (rounding allowance).
# Duplicate results: same owner/IP + same payload (mode, wpm,
# rawWpm, accuracy, correct/incorrect chars, elapsed, wordCount)
# within 60 seconds are rejected with 400 "Duplicate result".
# Duplicate state is in-memory only (same restart caveat as above).

# Phase 3 leaderboard note: GET /api/leaderboards returns only
# displayName + wpm + accuracy + mode, never email/ownerId/hash.
# displayName is "anonymous" in Phase 3 because StoredResult does
# not carry a displayName yet. Phase 4: store the owner's
# displayName on results at creation time (from the verified
# token's user record) and use it in the leaderboard entries.
